# User defined flags.

# flags that control toolchains
build --flag_alias=experimental_kernel_use_resolved_toolchains=@kleaf//build/kernel/kleaf:incompatible_kernel_use_resolved_toolchains
build --flag_alias=noexperimental_kernel_use_resolved_toolchains=no@kleaf//build/kernel/kleaf:incompatible_kernel_use_resolved_toolchains
build --flag_alias=incompatible_kernel_use_resolved_toolchains=@kleaf//build/kernel/kleaf:incompatible_kernel_use_resolved_toolchains
build --flag_alias=noincompatible_kernel_use_resolved_toolchains=no@kleaf//build/kernel/kleaf:incompatible_kernel_use_resolved_toolchains
