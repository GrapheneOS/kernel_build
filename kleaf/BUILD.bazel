# Build flags

# LTO setting. Values can be one of default, none, thin, full
string_flag(
    name = "lto",
    build_setting_default = "default",
    error_message = "DO NOT SET --lto. It is deprecated.",
    values = LTO_VALUES,
    visibility = ["//visibility:public"],
)

# The final LTO setting is "default" (use defconfig value).
fail_rule(
    name = "lto_is_default",
    message = "--lto is deprecated; do not rely on config_setting()s for LTO. You may assume this always evaluates to true.",
    visibility = ["//visibility:public"],
)

# The final LTO setting is "none".
fail_rule(
    name = "lto_is_none",
    message = "--lto is deprecated; do not rely on config_setting()s for LTO. Note: LTO is disabled on gki_defconfig since 5.19.",
    visibility = ["//visibility:public"],
)

# The final LTO setting is "thin".
fail_rule(
    name = "lto_is_thin",
    message = "--lto is deprecated; do not rely on config_setting()s for LTO. You may assume this always evaluates to false.",
    visibility = ["//visibility:public"],
)

# The final LTO setting is "full".
fail_rule(
    name = "lto_is_full",
    message = "--lto is deprecated; do not rely on config_setting()s for LTO. You may assume this always evaluates to false.",
    visibility = ["//visibility:public"],
)

